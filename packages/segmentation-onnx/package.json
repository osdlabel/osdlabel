{
  "name": "@osdlabel/segmentation-onnx",
  "version": "0.21.0",
  "private": true,
  "description": "PoC: SAM-family ONNX graph adapters (SAM/MobileSAM/EdgeSAM, EfficientSAM, SAM 2) over an injected onnxruntime, and the WebGPU-vs-WASM execution-provider gate.",
