{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**",
        "scripts/**",
        "public/**",
        "index.html",
        "tsconfig*.json",
        "vite.config.*",
        "astro.config.*",
        "package.json"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "tsconfig*.json", "package.json"]
    },
    "test": {
      "dependsOn": [],
      "inputs": [
        "src/**",
        "tests/**",
        "tsconfig*.json",
        "vitest.config.*",
        "vite.config.*",
        "package.json"
      ]
    },
    "@osdlabel/docs#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**",
        "scripts/**",
        "public/**",
        "index.html",
        "tsconfig*.json",
        "vite.config.*",
        "astro.config.*",
        "package.json",
        "$TURBO_ROOT$/packages/*/typedoc.json",
        "$TURBO_ROOT$/packages/*/package.json"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "inputs": [
        "src/**",
        "tests/**",
        "scripts/**",
        "*.config.*",
        "eslint.config.*",
        "$TURBO_ROOT$/eslint.config.*",
        "package.json"
      ]
    },
    "//#lint:root": {
      "inputs": ["eslint.config.js", "scripts/**", "package.json"]
    }
  }
}
