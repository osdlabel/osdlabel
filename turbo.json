{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**",
        "scripts/**",
        "public/**",
        "index.html",
        "tsconfig*.json",
        "vite.config.*",
        "astro.config.*",
        "package.json"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "tsconfig*.json", "package.json"]
    },
    "test": {
      "dependsOn": [],
      "inputs": ["src/**", "tests/**", "vitest.config.*", "package.json"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "inputs": ["src/**", "tests/**", "eslint.config.*", "package.json"]
    }
  }
}
