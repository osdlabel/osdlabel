{
  "name": "@osdlabel/docs",
  "version": "0.1.29",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-llm-page.js && pnpm check:typedoc && astro build && node scripts/check-rendered-tables.js",
    "check:typedoc": "typedoc --options typedoc.config.mjs --emit none --treatWarningsAsErrors",
    "preview": "astro preview",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.39.3",
    "@osdlabel/annotation": "workspace:*",
    "@osdlabel/annotation-context": "workspace:*",
    "@osdlabel/react": "workspace:*",
    "@osdlabel/solid": "workspace:*",
    "@osdlabel/viewer-api": "workspace:*",
    "astro": "^6.4.4",
    "osdlabel": "workspace:*",
    "sharp": "^0.33.5",
    "starlight-package-managers": "0.12.0",
    "starlight-typedoc": "^0.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1"
  },
  "devDependencies": {
    "@astrojs/solid-js": "^6.0.1",
    "solid-js": "catalog:"
  }
}
