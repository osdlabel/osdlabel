---
// The site's 404 page, replacing Starlight's built-in one (`disable404Route`
// in astro.config.mjs). It renders the same splash page as Starlight's
// default. Starlight's own route first looks for an optional `404` entry in
// the docs collection, and that lookup logs "Entry docs → 404 was not found"
// on every build; a `404.md` entry instead collides with the docs catch-all
// route.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: '404',
    template: 'splash',
    editUrl: false,
    pagefind: false,
    hero: { tagline: 'Page not found. Check the URL or try using the search bar.' },
  }}
/>
