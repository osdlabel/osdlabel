{
  "name": "@osdlabel/poc-sam",
  "version": "0.0.0",
  "author": "Guy Or <guydude1@gmail.com>",
  "private": true,
  "type": "module",
  "description": "Proof of concept: SAM-style assisted annotation for osdlabel (latency, gigapixel crops, mask output).",
  "scripts": {
    "dev": "vite",
    "fetch-models": "turbo run build --filter=@osdlabel/poc-sam^... --output-logs=errors-only && node scripts/fetch-models.mjs",
    "bench": "turbo run build --filter=@osdlabel/poc-sam^... --output-logs=errors-only && node scripts/bench.mjs",
    "bench:summary": "node scripts/summary.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@osdlabel/annotation": "workspace:*",
    "@osdlabel/annotation-context": "workspace:*",
    "@osdlabel/fabric-annotations": "workspace:*",
    "@osdlabel/fabric-osd": "workspace:*",
    "@osdlabel/mask": "workspace:*",
    "@osdlabel/mask-contour": "workspace:*",
    "@osdlabel/region-reader": "workspace:*",
    "@osdlabel/segmentation": "workspace:*",
    "@osdlabel/segmentation-fabric": "workspace:*",
    "@osdlabel/segmentation-onnx": "workspace:*",
    "@osdlabel/segmentation-remote": "workspace:*",
    "@osdlabel/segmentation-worker": "workspace:*",
    "@osdlabel/viewer-api": "workspace:*",
    "fabric": "catalog:",
    "onnxruntime-web": "1.30.0",
    "openseadragon": "catalog:",
    "osdlabel": "workspace:*"
  },
  "devDependencies": {
    "@types/openseadragon": "catalog:",
    "jpeg-js": "^0.4.4",
    "onnxruntime-node": "1.30.0",
    "playwright": "^1.60.0",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
