{
  "name": "osdlabel-workspace",
  "version": "0.0.0",
  "author": "Guy Or <guydude1@gmail.com>",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "scripts": {
    "bench": "turbo bench --filter=@osdlabel/bench",
    "bench:compare": "turbo bench:compare --filter=@osdlabel/bench",
    "build": "turbo build",
    "check-versions": "node scripts/check-versions.js",
    "dev": "turbo dev",
    "docs:build": "turbo --filter @osdlabel/docs build",
    "docs:dev": "turbo --filter @osdlabel/docs dev",
    "docs:preview": "turbo --filter @osdlabel/docs preview",
    "format": "prettier --write .",
    "lint": "turbo lint lint:root",
    "lint:root": "eslint eslint.config.js scripts/",
    "test": "turbo test",
    "test:all": "turbo run test test:e2e",
    "test:e2e": "turbo test:e2e",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-solid": "catalog:",
    "playwright": "^1.60.0",
    "prettier": "catalog:",
    "turbo": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osdlabel/osdlabel.git"
  }
}
